{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/ingest_job.schema.json",
  "title": "IngestJob",
  "type": "object",
  "required": ["job_id", "seed_urls", "mode", "output_root", "download"],
  "properties": {
    "job_id": {"type": "string", "minLength": 1},
    "seed_urls": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "format": "uri"}
    },
    "mode": {"type": "string", "enum": ["user", "like", "mix", "allmix", "music", "url"]},
    "time_range": {
      "type": "object",
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      },
      "required": ["start", "end"],
      "additionalProperties": false
    },
    "output_root": {"type": "string", "minLength": 1},
    "download": {
      "type": "object",
      "required": ["concurrency", "rate_limit_per_sec", "max_retries", "timeout_sec", "include"],
      "properties": {
        "concurrency": {"type": "integer", "minimum": 1, "maximum": 20},
        "rate_limit_per_sec": {"type": "number", "exclusiveMinimum": 0},
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 20},
        "timeout_sec": {"type": "integer", "minimum": 1},
        "include": {
          "type": "object",
          "required": ["video", "cover", "metadata"],
          "properties": {
            "video": {"type": "boolean"},
            "cover": {"type": "boolean"},
            "metadata": {"type": "boolean"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "naming": {
      "type": "object",
      "properties": {
        "pattern": {"type": "string"}
      },
      "additionalProperties": false
    },
    "resume": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "state_file": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
